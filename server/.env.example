# Copy to server/.env for local development. Railway injects PORT itself.
PORT=4000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# Add "null" to allow the packaged Electron app, which loads from file://.
CORS_ORIGINS=http://localhost:3000

# Postgres service's public URL (Variables tab -> DATABASE_PUBLIC_URL).
# The deployed API uses the private ${{Postgres.DATABASE_URL}} instead.
DATABASE_URL=postgresql://postgres:password@host.proxy.rlwy.net:12345/railway

# Same Clerk instance as the Next.js app (.env.local).
CLERK_SECRET_KEY=sk_test_...
# Optional but recommended: verify session tokens without calling Clerk.
# Clerk dashboard -> API keys -> Show JWT public key -> PEM. One line, with a
# literal \n for each newline. It's a public key, not a secret.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Optional: origins allowed to issue tokens (azp). Defaults to CORS_ORIGINS minus "null".
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://luminanotes.ai

# Railway bucket (S3-compatible). Get values with:
#   railway bucket credentials --bucket lumina-uploads
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=lumina-uploads-xxxxxxxxxx
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional upload limits, in bytes. Defaults: 100 MB per file, 2 GB per user per day.
# MAX_UPLOAD_BYTES=104857600
# UPLOAD_BYTES_PER_DAY=2147483648

# Same Gemini key as the Next.js app (.env.local). Optional: the app boots
# without it, but every /api/v1/ai/* route errors until it's set.
GEMINI_API_KEY=
# Models tried in order; the next one is used when one is overloaded (503),
# rate limited (429) or retired (404). Defaults to the list below.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Job queue (BullMQ on Redis), used by the API (to enqueue) and the worker.
# Locally: the Railway Redis service's public URL (Variables -> REDIS_PUBLIC_URL).
# Deployed: ${{Redis.REDIS_URL}} (private network).
REDIS_URL=redis://default:password@host.proxy.rlwy.net:12345
# Namespaces every queue key. Use something personal locally (e.g. dev-yourname)
# so your laptop never picks up production jobs; Railway services use "prod".
QUEUE_PREFIX=dev-yourname
# Optional worker tuning. Defaults: 2 jobs at once, 10 job starts per minute.
# AI_WORKER_CONCURRENCY=2
# AI_WORKER_RATE_PER_MIN=10

# Seals students' Brightspace feed URLs and tokens at rest. 32 random bytes,
# base64: `openssl rand -base64 32`. Changing it forces every student to reconnect.
LMS_ENCRYPTION_KEY=
